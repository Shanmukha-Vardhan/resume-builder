<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Resume</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <style>
    body.generating-pdf { cursor: wait; }
    body.generating-pdf * { pointer-events: none; }
    #pdf-iframe {
      position: absolute;
      left: -9999px;
      top: -9999px;
      width: 900px;
      height: 1120px;
      border: 0;
    }
  </style>
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/resume">Create Resume</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </nav>

  <div class="container">
    <h1>Create Your Resume</h1>

    <div>
      <label for="template">Select Template:</label>
      <select id="template" name="template">
        <option value="default">Default</option>
        <option value="modern">Modern</option>
        <option value="classic">Classic</option>
      </select>
    </div>

    <div class="resume-builder">
      <form id="resume-form">
        <fieldset>
          <legend>Personal Information</legend>
          <label for="name">Name <span title="Enter your full name">*</span></label>
          <input type="text" id="name" name="name" placeholder="Enter your name" required>
          <label for="email">Email <span title="Enter your email address">*</span></label>
          <input type="email" id="email" name="email" placeholder="Enter your email" required>
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" placeholder="Enter your phone number">
          <label for="linkedin">LinkedIn</label>
          <input type="url" id="linkedin" name="linkedin" placeholder="Enter your LinkedIn URL">
          <label for="github">GitHub</label>
          <input type="url" id="github" name="github" placeholder="Enter your GitHub URL">
          <label for="photo">Profile Photo (Optional)</label>
          <input type="file" id="photo" name="photo" accept="image/*">
        </fieldset>

        <fieldset>
          <legend>Objective</legend>
          <label for="objective">Summary <span title="Write a brief professional summary"></span></label>
          <textarea id="objective" name="objective" placeholder="e.g., Seeking a software engineering position..."></textarea>
        </fieldset>

        <fieldset id="education-section">
          <legend>Education</legend>
          <div class="education-entry">
            <label for="institution-0">Institution <span title="Enter institution name">*</span></label>
            <input type="text" id="institution-0" name="education[0][institution]" placeholder="e.g., XYZ University" required>
            <label for="degree-0">Degree</label>
            <input type="text" id="degree-0" name="education[0][degree]" placeholder="e.g., B.S. Computer Science">
            <label for="year-0">Year</label>
            <input type="number" id="year-0" name="education[0][year]" placeholder="e.g., 2023">
            <label for="cgpa-0">CGPA</label>
            <input type="number" id="cgpa-0" name="education[0][cgpa]" step="0.01" placeholder="e.g., 3.8">
          </div>
          <button type="button" id="add-education">Add Education</button>
        </fieldset>

        <fieldset id="experience-section">
          <legend>Experience</legend>
          <div class="experience-entry">
            <label for="company-0">Company <span title="Enter company name">*</span></label>
            <input type="text" id="company-0" name="experience[0][company]" placeholder="e.g., ABC Corp" required>
            <label for="role-0">Role</label>
            <input type="text" id="role-0" name="experience[0][role]" placeholder="e.g., Software Engineer">
            <label for="duration-0">Duration</label>
            <input type="text" id="duration-0" name="experience[0][duration]" placeholder="e.g., Jan 2022 - Present">
            <label for="responsibilities-0">Responsibilities</label>
            <textarea id="responsibilities-0" name="experience[0][responsibilities]" placeholder="e.g., Developed web applications..."></textarea>
          </div>
          <button type="button" id="add-experience">Add Experience</button>
        </fieldset>

        <fieldset id="projects-section">
          <legend>Projects</legend>
          <div class="project-entry">
            <label for="project-title-0">Title <span title="Enter project title">*</span></label>
            <input type="text" id="project-title-0" name="projects[0][title]" placeholder="e.g., E-commerce Platform" required>
            <label for="project-desc-0">Description</label>
            <textarea id="project-desc-0" name="projects[0][description]" placeholder="e.g., Built a full-stack application..."></textarea>
            <label for="project-tech-0">Tech Stack</label>
            <input type="text" id="project-tech-0" name="projects[0][tech]" placeholder="e.g., React, Node.js, MongoDB">
            <label for="project-link-0">GitHub Link</label>
            <input type="url" id="project-link-0" name="projects[0][link]" placeholder="e.g., https://github.com/...">
          </div>
          <button type="button" id="add-project">Add Project</button>
        </fieldset>

        <fieldset id="skills-section">
          <legend>Skills</legend>
          <div class="skill-entry">
            <label for="skill-0">Skill <span title="Enter a skill">*</span></label>
            <input type="text" id="skill-0" name="skills[]" placeholder="e.g., JavaScript" required>
          </div>
          <button type="button" id="add-skill">Add Skill</button>
        </fieldset>

        <fieldset id="certifications-section">
          <legend>Certifications</legend>
          <div class="certification-entry">
            <label for="cert-title-0">Title <span title="Enter certification title">*</span></label>
            <input type="text" id="cert-title-0" name="certifications[0][title]" placeholder="e.g., AWS Certified Developer" required>
            <label for="cert-issuer-0">Issuer</label>
            <input type="text" id="cert-issuer-0" name="certifications[0][issuer]" placeholder="e.g., Amazon">
            <label for="cert-date-0">Date</label>
            <input type="date" id="cert-date-0" name="certifications[0][date]">
          </div>
          <button type="button" id="add-certification">Add Certification</button>
        </fieldset>

        <fieldset id="languages-section">
          <legend>Languages</legend>
          <div class="language-entry">
            <label for="language-0">Language <span title="Enter a language">*</span></label>
            <input type="text" id="language-0" name="languages[]" placeholder="e.g., English" required>
          </div>
          <button type="button" id="add-language">Add Language</button>
        </fieldset>

        <fieldset id="interests-section">
          <legend>Interests/Hobbies</legend>
          <div class="interest-entry">
            <label for="interest-0">Interest <span title="Enter an interest or hobby">*</span></label>
            <input type="text" id="interest-0" name="interests[]" placeholder="e.g., Hiking" required>
          </div>
          <button type="button" id="add-interest">Add Interest</button>
        </fieldset>

        <button type="button" id="download-pdf">Download PDF</button>
      </form>

      <div id="preview">
        <h2>Resume Preview</h2>
        <div id="preview-content">
          <p>Fill in the form to see your resume preview.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('resume-form');
      const previewContent = document.getElementById('preview-content');
      const previewContainer = document.getElementById('preview');
      const templateSelect = document.getElementById('template');
      const downloadBtn = document.getElementById('download-pdf');

      if (!form || !previewContent || !previewContainer || !downloadBtn) {
        console.error("Essential elements missing!");
        if (downloadBtn) downloadBtn.disabled = true;
        return;
      }

      const educationTemplate = `
        <label for="institution-TIMESTAMP">Institution *</label>
        <input type="text" id="institution-TIMESTAMP" name="education[TIMESTAMP][institution]" placeholder="e.g., XYZ University" required>
        <label for="degree-TIMESTAMP">Degree</label>
        <input type="text" id="degree-TIMESTAMP" name="education[TIMESTAMP][degree]" placeholder="e.g., B.S. Computer Science">
        <label for="year-TIMESTAMP">Year</label>
        <input type="number" id="year-TIMESTAMP" name="education[TIMESTAMP][year]" placeholder="e.g., 2023">
        <label for="cgpa-TIMESTAMP">CGPA</label>
        <input type="number" id="cgpa-TIMESTAMP" name="education[TIMESTAMP][cgpa]" step="0.01" placeholder="e.g., 3.8">
        <button type="button" class="remove-entry" data-section="education">Remove</button>
      `;
      const experienceTemplate = `
        <label for="company-TIMESTAMP">Company *</label>
        <input type="text" id="company-TIMESTAMP" name="experience[TIMESTAMP][company]" placeholder="e.g., ABC Corp" required>
        <label for="role-TIMESTAMP">Role</label>
        <input type="text" id="role-TIMESTAMP" name="experience[TIMESTAMP][role]" placeholder="e.g., Software Engineer">
        <label for="duration-TIMESTAMP">Duration</label>
        <input type="text" id="duration-TIMESTAMP" name="experience[TIMESTAMP][duration]" placeholder="e.g., Jan 2022 - Present">
        <label for="responsibilities-TIMESTAMP">Responsibilities</label>
        <textarea id="responsibilities-TIMESTAMP" name="experience[TIMESTAMP][responsibilities]" placeholder="e.g., Developed web applications..."></textarea>
        <button type="button" class="remove-entry" data-section="experience">Remove</button>
      `;
      const projectTemplate = `
        <label for="project-title-TIMESTAMP">Title *</label>
        <input type="text" id="project-title-TIMESTAMP" name="projects[TIMESTAMP][title]" placeholder="e.g., E-commerce Platform" required>
        <label for="project-desc-TIMESTAMP">Description</label>
        <textarea id="project-desc-TIMESTAMP" name="projects[TIMESTAMP][description]" placeholder="e.g., Built a full-stack application..."></textarea>
        <label for="project-tech-TIMESTAMP">Tech Stack</label>
        <input type="text" id="project-tech-TIMESTAMP" name="projects[TIMESTAMP][tech]" placeholder="e.g., React, Node.js, MongoDB">
        <label for="project-link-TIMESTAMP">GitHub Link</label>
        <input type="url" id="project-link-TIMESTAMP" name="projects[TIMESTAMP][link]" placeholder="e.g., https://github.com/...">
        <button type="button" class="remove-entry" data-section="projects">Remove</button>
      `;
      const skillTemplate = `
        <label for="skill-TIMESTAMP">Skill *</label>
        <input type="text" id="skill-TIMESTAMP" name="skills[]" placeholder="e.g., Python" required>
        <button type="button" class="remove-entry" data-section="skills">Remove</button>
      `;
      const certificationTemplate = `
        <label for="cert-title-TIMESTAMP">Title *</label>
        <input type="text" id="cert-title-TIMESTAMP" name="certifications[TIMESTAMP][title]" placeholder="e.g., Google Cloud Certified" required>
        <label for="cert-issuer-TIMESTAMP">Issuer</label>
        <input type="text" id="cert-issuer-TIMESTAMP" name="certifications[TIMESTAMP][issuer]" placeholder="e.g., Google">
        <label for="cert-date-TIMESTAMP">Date</label>
        <input type="date" id="cert-date-TIMESTAMP" name="certifications[TIMESTAMP][date]">
        <button type="button" class="remove-entry" data-section="certifications">Remove</button>
      `;
      const languageTemplate = `
        <label for="language-TIMESTAMP">Language *</label>
        <input type="text" id="language-TIMESTAMP" name="languages[]" placeholder="e.g., Spanish" required>
        <button type="button" class="remove-entry" data-section="languages">Remove</button>
      `;
      const interestTemplate = `
        <label for="interest-TIMESTAMP">Interest *</label>
        <input type="text" id="interest-TIMESTAMP" name="interests[]" placeholder="e.g., Reading" required>
        <button type="button" class="remove-entry" data-section="interests">Remove</button>
      `;

      const sections = {
        education: { template: educationTemplate, entryClass: 'education-entry', addButtonId: 'add-education' },
        experience: { template: experienceTemplate, entryClass: 'experience-entry', addButtonId: 'add-experience' },
        projects: { template: projectTemplate, entryClass: 'project-entry', addButtonId: 'add-project' },
        skills: { template: skillTemplate, entryClass: 'skill-entry', addButtonId: 'add-skill' },
        certifications: { template: certificationTemplate, entryClass: 'certification-entry', addButtonId: 'add-certification' },
        languages: { template: languageTemplate, entryClass: 'language-entry', addButtonId: 'add-language' },
        interests: { template: interestTemplate, entryClass: 'interest-entry', addButtonId: 'add-interest' },
      };

      function addEntry(sectionName) {
        const config = sections[sectionName];
        if (!config) {
          console.error(`Config not found for section "${sectionName}"`);
          return;
        }
        const sectionElement = document.getElementById(`${sectionName}-section`);
        const addButton = document.getElementById(config.addButtonId);
        if (!sectionElement || !addButton) {
          console.error(`Section or add button not found for "${sectionName}"`);
          return;
        }
        const newIndex = Date.now();
        const newEntryDiv = document.createElement('div');
        newEntryDiv.className = config.entryClass;
        newEntryDiv.innerHTML = config.template.replace(/TIMESTAMP/g, newIndex);
        sectionElement.insertBefore(newEntryDiv, addButton);
        updatePreview();
      }

      form.addEventListener('click', function(event) {
        if (event.target.classList.contains('remove-entry')) {
          const button = event.target;
          const sectionName = button.dataset.section;
          const config = sections[sectionName];
          if (!config) {
            console.error(`Config not found for section "${sectionName}" during remove.`);
            return;
          }
          const entryToRemove = button.closest(`.${config.entryClass}`);
          if (entryToRemove) {
            const sectionElement = document.getElementById(`${sectionName}-section`);
            const entryCount = sectionElement.querySelectorAll(`.${config.entryClass}`).length;
            if (entryCount <= 1) {
              alert(`You need at least one entry in the ${sectionName} section.`);
              return;
            }
            entryToRemove.remove();
            updatePreview();
          }
        }
      });

      Object.entries(sections).forEach(([sectionName, config]) => {
        const addButton = document.getElementById(config.addButtonId);
        if (addButton) {
          addButton.addEventListener('click', () => addEntry(sectionName));
        }
      });

      function updatePreview() {
        console.log('Updating preview...');
        const formData = new FormData(form);
        console.log('Form data:', Array.from(formData.entries()));
        let previewHtml = '';
        const sanitize = (str) => {
          if (!str) return '';
          const temp = document.createElement('div');
          temp.textContent = str;
          return temp.innerHTML.replace(/\n/g, '<br>');
        };
        const parseDynamicSection = (sectionName) => {
          const items = [];
          const indices = new Set();
          formData.forEach((_, key) => {
            const match = key.match(new RegExp(`^${sectionName}\\[([^\\]]+)\\]\\[\\w+\\]$`));
            if (match) indices.add(match[1]);
          });
          indices.forEach(index => {
            const item = { rawIndex: index };
            formData.forEach((value, key) => {
              const match = key.match(new RegExp(`^${sectionName}\\[${index}\\]\\[(\\w+)\\]$`));
              if (match) item[match[1]] = value;
            });
            let hasContent = false;
            Object.keys(item).forEach(field => {
              if (field !== 'rawIndex') {
                item[field] = sanitize(item[field]);
                if (item[field] && item[field].trim() !== '<br>') {
                  hasContent = true;
                }
              }
            });
            if (hasContent) {
              items.push(item);
            }
          });
          return items;
        };

        const linkedinUrl = sanitize(formData.get('linkedin') || '');
        const githubUrl = sanitize(formData.get('github') || '');
        const name = sanitize(formData.get('name') || 'Your Name');
        console.log('Name for preview:', name);
        const email = sanitize(formData.get('email') || '');
        const phone = sanitize(formData.get('phone') || '');
        previewHtml += `<h1>${name}</h1>`;
        let contactInfo = [phone, email, linkedinUrl, githubUrl].filter(Boolean).join(' | ');
        if (contactInfo) previewHtml += `<p>${contactInfo}</p>`;
        const objective = sanitize(formData.get('objective') || '');
        if (objective && objective.trim() !== '<br>') previewHtml += `<h2>SUMMARY</h2><p>${objective}</p>`;
        const education = parseDynamicSection('education');
        if (education.length > 0) {
          previewHtml += '<h2>EDUCATION</h2>';
          education.forEach(e => {
            if (e.institution && e.institution.trim() !== '<br>') {
              previewHtml += `<p><strong>${e.institution}</strong>${e.degree ? ` - ${e.degree}` : ''}<br>${e.year ? `Year: ${e.year}` : ''}${e.cgpa ? ` | CGPA: ${e.cgpa}` : ''}</p>`;
            }
          });
        }
        const experience = parseDynamicSection('experience');
        if (experience.length > 0) {
          previewHtml += '<h2>EXPERIENCE</h2>';
          experience.forEach(e => {
            if (e.company && e.company.trim() !== '<br>') {
              previewHtml += `<p><strong>${e.company}</strong>${e.role ? ` | ${e.role}` : ''}<br>${e.duration ? `${e.duration}<br>` : ''}${e.responsibilities || ''}</p>`;
            }
          });
        }
        const projects = parseDynamicSection('projects');
        if (projects.length > 0) {
          previewHtml += '<h2>PROJECTS</h2>';
          projects.forEach(p => {
            if (p.title && p.title.trim() !== '<br>') {
              const rawLink = formData.get(`projects[${p.rawIndex}][link]`) || '';
              previewHtml += `<p><strong>${p.title}</strong><br>${p.description ? `${p.description}<br>` : ''}${p.tech ? `Tech Stack: ${p.tech}<br>` : ''}${rawLink ? `Link: <a href="${sanitize(rawLink)}" target="_blank">${sanitize(rawLink)}</a>` : ''}</p>`;
            }
          });
        }
        const skills = formData.getAll('skills[]').map(s => sanitize(s)).filter(s => s && s.trim() && s !== '<br>');
        if (skills.length > 0) {
          previewHtml += '<h2>SKILLS</h2><ul>' + skills.map(s => `<li>${s}</li>`).join('') + '</ul>';
        }
        const certifications = parseDynamicSection('certifications');
        if (certifications.length > 0) {
          previewHtml += '<h2>CERTIFICATIONS</h2>';
          certifications.forEach(c => {
            if (c.title && c.title.trim() !== '<br>') {
              previewHtml += `<p><strong>${c.title}</strong>${c.issuer ? ` - ${c.issuer}` : ''}${c.date ? `, ${c.date}` : ''}</p>`;
            }
          });
        }
        const languages = formData.getAll('languages[]').map(l => sanitize(l)).filter(l => l && l.trim() && l !== '<br>');
        if (languages.length > 0) {
          previewHtml += '<h2>LANGUAGES</h2><p>' + languages.join(', ') + '</p>';
        }
        const interests = formData.getAll('interests[]').map(i => sanitize(i)).filter(i => i && i.trim() && i !== '<br>');
        if (interests.length > 0) {
          previewHtml += '<h2>INTERESTS</h2><p>' + interests.join(', ') + '</p>';
        }

        previewContent.innerHTML = previewHtml || '<p>Fill in the form to see your resume preview.</p>';
        console.log('Preview updated:', previewContent.innerHTML);
      }

      function applyTemplate() {
        const selectedTemplate = templateSelect.value;
        console.log(`Applying template: ${selectedTemplate}`);
      }

      if (templateSelect) {
        templateSelect.addEventListener('change', applyTemplate);
      }

      updatePreview();
      form.addEventListener('input', updatePreview);

      downloadBtn.addEventListener('click', () => {
        console.log("Starting PDF download process...");
        document.body.classList.add('generating-pdf');

        const livePreviewContent = document.getElementById('preview-content');
        console.log('Checking preview content:', livePreviewContent?.innerHTML);
        if (!livePreviewContent || !livePreviewContent.innerHTML.trim()) {
          console.error('No content in preview.');
          alert('Please add content to your resume before downloading.');
          document.body.classList.remove('generating-pdf');
          return;
        }
        console.log("Content found, proceeding with PDF generation.");

        const existingIframe = document.getElementById('pdf-iframe');
        if (existingIframe) {
          existingIframe.remove();
        }

        console.log("Creating hidden iframe...");
        const iframe = document.createElement('iframe');
        iframe.id = 'pdf-iframe';
        document.body.appendChild(iframe);

        const cssLink = '/css/style.css';
        const iframeHTML = `
          <!DOCTYPE html>
          <html>
          <head>
            <meta charset="UTF-8">
            <title>PDF Render</title>
            <link rel="stylesheet" href="${cssLink}">
            <style>
              body { margin: 0; padding: 0; }
              #iframe-preview-container {
                min-width: 900px;
                width: 100%;
                min-height: 1px;
                border: 1px solid #ccc;
                background: #fdfdfd;
                padding: 25px;
                box-sizing: border-box;
                font-size: 16px;
                font-family: Arial, sans-serif;
              }
              h1 { font-size: 28px; margin: 0 0 15px 0; }
            </style>
          </head>
          <body>
            <div id="iframe-preview-container">
              <div id="iframe-preview-content">
                ${livePreviewContent.innerHTML}
              </div>
            </div>
          </body>
          </html>
        `;

        iframe.contentWindow.document.open();
        iframe.contentWindow.document.write(iframeHTML);
        iframe.contentWindow.document.close();

        iframe.onload = () => {
          console.log("Iframe ready, generating PDF...");
          if (typeof html2pdf === 'undefined') {
            console.error('PDF library not loaded.');
            alert('PDF library error. Please try again.');
            document.body.classList.remove('generating-pdf');
            iframe.remove();
            return;
          }

          const nameInput = document.getElementById('name');
          console.log('Name for filename:', nameInput?.value);
          const filename = (nameInput && nameInput.value.trim()) ? `${nameInput.value.trim().replace(/\s+/g, '_')}_Resume.pdf` : 'resume.pdf';

          const elementToExportInIframe = iframe.contentWindow.document.getElementById('iframe-preview-container');
          if (!elementToExportInIframe) {
            console.error("Iframe content not found!");
            alert("Error: Could not generate PDF.");
            document.body.classList.remove('generating-pdf');
            iframe.remove();
            return;
          }

          const iframeElementHeight = elementToExportInIframe.offsetHeight;
          console.log(`Iframe content height: ${iframeElementHeight}px`);

          const opt = {
            margin: [10, 10, 10, 10],
            filename: filename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2,
              logging: true,
              useCORS: true,
              scrollY: 0,
              windowWidth: iframe.contentWindow.document.documentElement.scrollWidth,
              windowHeight: iframe.contentWindow.document.documentElement.scrollHeight
            },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          };

          html2pdf().set(opt).from(elementToExportInIframe).save()
            .then(() => { console.log('PDF downloaded successfully!'); })
            .catch((error) => { 
              console.error('PDF generation failed:', error); 
              alert(`Failed to generate PDF: ${error}`); 
            })
            .finally(() => {
              console.log("Cleaning up iframe.");
              iframe.remove();
              document.body.classList.remove('generating-pdf');
            });
        };

        iframe.onerror = (err) => {
          console.error("Iframe error:", err);
          alert("Error loading PDF content. Check if CSS file is accessible.");
          document.body.classList.remove('generating-pdf');
          iframe.remove();
        };
      });
    });
  </script>
</body>
</html>